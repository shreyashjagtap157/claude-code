# Copy to .env in this directory. The gateway loads .env without changing your shell.
# Environment variables already present in the process override values in .env.

# Required: provider base URL. Examples:
# OPENAI_COMPATIBLE_BASE_URL=https://provider.example/v1
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_BASE_URL=https://provider.example/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=your-model-id
# Optional: overrides capabilities.maxTokensField.
OPENAI_COMPATIBLE_MAX_TOKENS_FIELD=max_tokens
# Optional JSON object mapping Claude Code model IDs/aliases to upstream model IDs.
OPENAI_COMPATIBLE_MODEL_MAP={}
# Optional partial capability overrides keyed by requested alias or resolved upstream model ID.
OPENAI_COMPATIBLE_MODEL_CAPABILITIES={}
# Optional absolute path on the base URL origin, e.g. /openai/v1/chat/completions
OPENAI_COMPATIBLE_CHAT_COMPLETIONS_PATH=
# Capability flags are intentionally conservative. Only enable what you have verified.
OPENAI_COMPATIBLE_CAPABILITIES={"streaming":true,"toolCalling":false,"parallelToolCalls":false,"images":false,"jsonSchema":false,"reasoningEffort":false,"temperature":true,"topP":true,"stopSequences":true,"streamUsage":true,"streamRequiresDone":true,"maxTokensField":"max_tokens"}
OPENAI_COMPATIBLE_ALLOW_INSECURE_HTTP=false

GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=3456
# Optional local gateway auth, separate from OPENAI_COMPATIBLE_API_KEY.
GATEWAY_API_KEY=
GATEWAY_ALLOW_REMOTE=false
GATEWAY_LOG_LEVEL=info
GATEWAY_REQUEST_TIMEOUT_MS=600000
GATEWAY_STREAM_IDLE_TIMEOUT_MS=60000
GATEWAY_MAX_BODY_BYTES=2097152
GATEWAY_MAX_CONCURRENT_REQUESTS=32
